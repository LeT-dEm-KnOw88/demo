name: CI with Scandium

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read

    steps:
      - name: Checkout
        uses: actions/checkout@3df4ab11eba7bda6032e7f2a0cf4bb7c3b0c3c28  # v4.1.6

      - name: Install jq
        run: |
          sudo apt-get update -y
          sudo apt-get install -y jq

      - name: Run Scandium Test
        env:
          SCANDIUM_API_TOKEN: ${{ secrets.SCANDIUM_API_TOKEN }}
          SCANDIUM_PROJECT_ID: 99c98722-91d0-4741-8723-9f55dfb525cf
          SCANDIUM_SUITE_ID: 9ba18afc-b714-4da6-ba5b-b9f445467f5b
        run: |
          set -euo pipefail

          payload=$(jq -n --arg proj "$SCANDIUM_PROJECT_ID" \
                         --arg suite "$SCANDIUM_SUITE_ID" \
                         --arg browser "chrome" \
                         --argjson screenshot true \
                         --arg strategy "await" \
                         --argjson retry 0 \
                         --arg username "sdk" \
                         --argjson age 11 \
                         '{
                            project_id: $proj,
                            suite_id: $suite,
                            browser: $browser,
                            screenshot: $screenshot,
                            strategy: $strategy,
                            variables: { username: $username, age: $age },
                            retry: $retry
                          }')

          # Retry curl up to 3 times with backoff; fail on HTTP errors; quiet output but show on error
          response=$(attempt=0; until [ $attempt -ge 3 ]; do
              attempt=$((attempt+1))
              if out=$(curl -sSsf -X POST \
                -H "Content-Type: application/json" \
                -H "x-api-token: $SCANDIUM_API_TOKEN" \
                -d "$payload" \
                --max-time 60 \
                https://scr.getscandium.com/suites/execute); then
                echo "$out"; exit 0
              fi
              sleep $((attempt*3))
            done; exit 22)

          status=$(echo "$response" | jq -r '.data.result.status // empty')
          message=$(echo "$response" | jq -r '.message // empty')

          {
            echo "### Scandium Execution"
            echo ""
            echo "**Status:** \`$status\`"
            if [ -n "$message" ]; then echo "**Message:** $message"; fi
            echo ""
            echo "<details><summary>Raw response</summary>"
            echo ""
            echo '```json'
            echo "$response"
            echo '```'
            echo "</details>"
          } >> "$GITHUB_STEP_SUMMARY"

          if [ "$status" = "success" ]; then
            echo "Test ran successfully. Status: $status"
          else
            echo "Test ran with failure. Status: ${status:-unknown}"
            exit 1
          fi
